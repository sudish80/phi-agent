# =============================================================================
# PHI Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- API Keys ---
OPENAI_API_KEY=sk-...                          # OpenAI API key for GPT models
ANTHROPIC_API_KEY=sk-ant-...                   # Anthropic API key for Claude models
NVIDIA_API_KEY=nvapi-...                       # NVIDIA API key for NIM models

# --- Service Ports ---
ORCHESTRATOR_PORT=8000                         # Orchestrator FastAPI port
SPEECH_PORT=8765                              # Speech service WebSocket port

# --- Redis ---
REDIS_URL=redis://redis:6379/0                 # Redis connection string

# --- Logging ---
LOG_LEVEL=INFO                                # DEBUG, INFO, WARNING, ERROR

# --- Tool Profile ---
TOOL_PROFILE=full                             # full, minimal, computer-use

# --- Email ---
EMAIL_ADDRESS=you@gmail.com                    # SMTP sender address
EMAIL_PASSWORD=                                # SMTP app password
SMTP_SERVER=smtp.gmail.com                    # SMTP server hostname
SMTP_PORT=587                                 # SMTP server port (587/TLS)

# --- User ---
USER_NAME=User                                # Display name for the agent

# --- Security ---
JWT_SECRET=change-me-to-a-random-secret       # JWT signing secret
