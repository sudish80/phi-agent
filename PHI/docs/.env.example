# PHI Agent Configuration
# Copy this to .env and fill in your API keys

# --- Core ---
USER_NAME=User
PHI_WAKE_WORD=phi
LOG_LEVEL=INFO

# --- API Keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
ELEVENLABS_API_KEY=
SERPAPI_API_KEY=
WEATHER_API_KEY=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- ChromaDB (Memory) ---
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=phi_memory

# --- MQTT (Home Assistant) ---
MQTT_BROKER=homeassistant.local
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Email ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# --- Services ---
ORCHESTRATOR_PORT=8000
VISION_PORT=8001
HEARING_PORT=8002
SPEECH_PORT=8003
ACTION_PORT=8004

# --- Vision ---
CAMERA_INDEX=0
CAMERA_RTSP_URL=
DETECTION_INTERVAL=0.1
FACE_RECOGNITION_ENABLED=true

# --- Hearing ---
MIC_INDEX=0
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=500
WHISPER_MODEL=tiny
WAKE_WORD_SENSITIVITY=0.5

# --- Speech ---
TTS_ENGINE=elevenlabs
TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TTS_LOCAL_MODEL=tts_models/en/ljspeech/tacotron2-DDC
TTS_CACHE_ENABLED=true

# --- LLM ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LOCAL_LLM_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=llama-3-70b
MAX_TOKENS=4096
TEMPERATURE=0.7

# --- Memory Palace ---
MEMORY_PALACE_ENABLED=true
MEMORY_PALACE_ROOMS=20
MEMORY_DIMENSION=1536
MEMORY_TOP_K=5
