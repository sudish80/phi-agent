{
  "name": "phi-agent",
  "version": "1.0.0",
  "description": "PHI Agent Desktop - J.A.R.V.I.S. AI Assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "cd ../frontend && npm run build && cd ../electron && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.phi.agent",
    "productName": "PHI Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": ["**/*", "!__pycache__/**", "!*.pyc"]
      },
      {
        "from": "../frontend/build",
        "to": "frontend/build"
      },
      {
        "from": "../.env",
        "to": ".env"
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
